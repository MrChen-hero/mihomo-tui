#!/usr/bin/env node
// mihomo-tui 可执行入口。
// 优先跑已编译的 dist/cli.js；未编译时回退到 tsx 直跑 TypeScript 源码（开发期）。
import { spawnSync } from 'node:child_process'
import { existsSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath, pathToFileURL } from 'node:url'

const root = dirname(dirname(fileURLToPath(import.meta.url)))
const compiled = join(root, 'dist', 'cli.js')

if (existsSync(compiled)) {
  await import(pathToFileURL(compiled).href)
} else {
  const tsx = join(root, 'node_modules', 'tsx', 'dist', 'cli.mjs')
  if (!existsSync(tsx)) {
    process.stderr.write('未找到 dist/cli.js，也未安装 tsx。请先执行：npm install && npm run build\n')
    process.exit(1)
  }
  const result = spawnSync(process.execPath, [tsx, join(root, 'src', 'cli.tsx'), ...process.argv.slice(2)], {
    stdio: 'inherit',
  })
  process.exit(result.status ?? 1)
}
